@model IEnumerable<GymAttendanceSystem.Models.MemberVisit>

@{
    ViewData["Title"] = "Gym Attendance Log";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-light fw-bold">Gym Attendance Log</h2>
    <a asp-action="Create" class="btn btn-secondary border-light text-white">+ New Visit</a>
</div>

<!-- Search Bar -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control bg-dark text-white border-secondary" placeholder="Search by Member ID, Name, or Visit #..." />
        <button type="submit" class="btn btn-outline-light">Search</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-dark table-striped table-hover align-middle border-secondary">
        <thead>
            <tr class="table-active">
                <th>Visit #</th>
                <th>Member</th>
                <th>Membership</th>
                <th>Time In</th>
                <th>Time Out</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-secondary py-4">No visit records found.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.VisitNumber</td>
                    <td>@item.FirstName @item.LastName <br /><small class="text-secondary">ID: @item.MemberId</small></td>
                    <td>@item.MembershipType</td>
                    <td>@item.TimeIn.ToString("hh:mm tt")</td>
                    <td>@(item.TimeOut?.ToString("hh:mm tt") ?? "-")</td>
                    <td>
                        @if (item.Status == "Inside Gym")
                        {
                            <span class="badge bg-success">Inside Gym</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary border border-light">Checked Out</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        @if (item.Status == "Inside Gym")
                        {
                            <form asp-action="CheckOut" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger">Check Out</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
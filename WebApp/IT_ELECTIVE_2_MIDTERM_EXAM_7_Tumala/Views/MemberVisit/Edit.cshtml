@model GymAttendanceSystem.Models.MemberVisit

@{
    ViewData["Title"] = "Edit Member Visit";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Edit Visit Record</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="VisitNumber" class="form-label"></label>
                            <input asp-for="VisitNumber" class="form-control" />
                            <span asp-validation-for="VisitNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="MemberId" class="form-label"></label>
                            <input asp-for="MemberId" class="form-control" />
                            <span asp-validation-for="MemberId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="MembershipType" class="form-label"></label>
                            <select asp-for="MembershipType" class="form-select">
                                <option value="Standard">Standard</option>
                                <option value="VIP">VIP</option>
                                <option value="Student">Student</option>
                                <option value="Day Pass">Day Pass</option>
                            </select>
                            <span asp-validation-for="MembershipType" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label"></label>
                            <input asp-for="ContactNumber" class="form-control" />
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WorkoutPurpose" class="form-label"></label>
                        <input asp-for="WorkoutPurpose" class="form-control" />
                        <span asp-validation-for="WorkoutPurpose" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <button type="submit" class="btn btn-warning">Update Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
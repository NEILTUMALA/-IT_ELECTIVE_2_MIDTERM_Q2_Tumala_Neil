@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card bg-secondary text-white shadow border-secondary">
            <div class="card-header bg-black text-white text-center border-secondary py-3">
                <h3 class="mb-0">Gym Staff Login</h3>
            </div>
            <div class="card-body bg-dark text-light p-4">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label text-light">Username</label>
                        <input name="username" class="form-control bg-secondary text-white border-dark" placeholder="Enter username" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light">Password</label>
                        <input name="password" type="password" class="form-control bg-secondary text-white border-dark" placeholder="Enter password" required />
                    </div>

                    <button type="submit" class="btn btn-secondary text-white w-100 fw-bold border-light mt-2">Log In</button>
                </form>

                <div class="mt-3 text-center">
                    <a asp-action="Register" class="text-light text-decoration-underline">Don't have an account? Register here</a>
                </div>
            </div>
        </div>
    </div>
</div>